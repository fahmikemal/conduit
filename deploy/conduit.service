# /etc/systemd/system/conduit.service
#
#   systemctl reload conduit     zero-downtime restart: new binary and/or listen addresses.
#                                The new process validates the config first; if it fails,
#                                the reload aborts and the old process keeps serving.
#   systemctl kill -s HUP conduit
#                                reload sites and certificates in place (also automatic when
#                                the config or a certificate file changes).
[Unit]
Description=conduit reverse proxy
Documentation=file:///etc/conduit/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/conduit/conduit.pid
ExecStartPre=/usr/local/bin/conduit check -c /etc/conduit/conduit.yaml
ExecStart=/usr/local/bin/conduit run -d -c /etc/conduit/conduit.yaml
# Start the replacement first (it waits for the listeners), then tell the old one to hand them
# over. systemd re-reads PIDFile when the old process exits.
ExecReload=/usr/local/bin/conduit run -d -u -c /etc/conduit/conduit.yaml
ExecReload=/bin/kill -QUIT $MAINPID
# SIGTERM waits server.shutdown_grace (default 60s) for in-flight requests.
TimeoutStopSec=90
Restart=on-failure
RestartSec=2

User=conduit
Group=conduit
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RuntimeDirectory=conduit
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
LogsDirectory=conduit
LogsDirectoryMode=0750
# /var/lib/conduit: tls.acme.storage (account key and certificates).
StateDirectory=conduit
StateDirectoryMode=0700
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
